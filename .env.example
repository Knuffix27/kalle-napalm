# Napalm Network Device Collector - Environment Variables Template
# Kopiere diese Datei zu .env und fülle deine Werte ein
# cp .env.example .env

# ============================================================================
# Netbox API Configuration
# ============================================================================

# Netbox API URL (z.B. https://netbox.example.com)
# Hinweis: Keine trailing slash!
NETBOX_URL=https://netbox.example.com

# Netbox API Token
# Generiere einen unter: https://netbox.example.com/user/api-tokens/
NETBOX_TOKEN=0123456789abcdefghijklmnopqrstuvwxyz

# SSL Zertifikats-Verifikation (true/false)
# Nur auf false setzen falls selbstsigniertes Zertifikat
NETBOX_SSL_VERIFY=true

# ============================================================================
# Optional: Netzwerk-Proxy Settings
# ============================================================================

# HTTP Proxy (z.B. für Firewalls)
# HTTP_PROXY=http://proxy.example.com:8080

# HTTPS Proxy
# HTTPS_PROXY=http://proxy.example.com:8080

# No Proxy (Adressen ohne Proxy)
# NO_PROXY=localhost,127.0.0.1,.example.com

# ============================================================================
# Optional: SSH/Paramiko Settings
# ============================================================================

# Standard SSH Key Path (wenn nicht in config.yaml angegeben)
# SSH_KEY_PATH=~/.ssh/id_rsa

# SSH Config File
# SSH_CONFIG_FILE=~/.ssh/config

# SSH Agent Socket Path (für SSH Agent Authentication)
# SSH_AUTH_SOCK=/tmp/ssh-XXXXXXXXXX/agent.xxxxx

# ============================================================================
# Optional: Logging Configuration
# ============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Path
LOG_FILE=napalm_collector.log

# Log Format: json, text
# LOG_FORMAT=text

# ============================================================================
# Optional: Sentry Error Tracking
# ============================================================================

# Sentry DSN für Exception Tracking (optional)
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================================================
# Optional: Slack Notifications
# ============================================================================

# Slack Webhook URL für Fehlermeldungen (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Notification Channel
# SLACK_CHANNEL=#network-monitoring

# ============================================================================
# Optional: Performance Settings
# ============================================================================

# Maximale Anzahl gleichzeitiger Device-Verbindungen
# MAX_CONNECTIONS=10

# Request Timeout in Sekunden
# CONNECTION_TIMEOUT=30

# Retry Count bei Fehlern
# RETRY_COUNT=2

# ============================================================================
# Verwendung
# ============================================================================

# Option 1: Automatisches Laden mit python-dotenv
# from dotenv import load_dotenv
# load_dotenv()

# Option 2: Manuell laden in Shell
# source .env

# Option 3: Beim Script-Start
# ./run.sh --env-only --config config.yaml

# ============================================================================
# Sicherheit
# ============================================================================

# 1. .env NICHT in Git committen!
#    Bereits in .gitignore, aber zur Sicherheit wieder prüfen
#
# 2. Dateiberechtigung setzen:
#    chmod 600 .env
#
# 3. Passwörter nicht hier speichern - stattdessen SSH-Keys verwenden
#
# 4. Für Production: Secrets Management Tool nutzen (Vault, etc.)
#    statt .env Datei

# ============================================================================
